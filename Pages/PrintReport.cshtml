@page
@model StudentComplaintSystem.Pages.PrintReportModel

@{
    ViewData["Title"] = "Complaint Resolution Report";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
    }

    .report {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 40px;
        border: 1px solid #ccc;
    }

    h2, h4 {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 25px;
    }

    td {
        border: 1px solid #ccc;
        padding: 12px;
        vertical-align: top;
    }

    .label {
        width: 220px;
        font-weight: bold;
        background: #f7f7f7;
    }

    .print-btn {
        margin-top: 30px;
        text-align: center;
    }

    @@media print {
        .print-btn {
            display: none;
        }

        body {
            background: white;
        }

        .report {
            border: none;
            margin: 0;
            max-width: 100%;
        }
    }
</style>

<div class="report">

    <h2>Lead City University</h2>
    <h4>Complaint Resolution Report</h4>

    <table>

        <tr>
            <td class="label">Complaint ID</td>
            <td>@Model.Complaint.Id</td>
        </tr>

        <tr>
            <td class="label">Student Name</td>
            <td>@Model.Complaint.StudentName</td>
        </tr>

        <tr>
            <td class="label">Matric Number</td>
            <td>@Model.Complaint.MatricNumber</td>
        </tr>

        <tr>
            <td class="label">Level</td>
            <td>@Model.Complaint.Level</td>
        </tr>

        <tr>
            <td class="label">Issue Title</td>
            <td>@Model.Complaint.Title</td>
        </tr>

        <tr>
            <td class="label">Description</td>
            <td>@Model.Complaint.Description</td>
        </tr>

        <tr>
            <td class="label">Status</td>
            <td><strong>@Model.Complaint.Status</strong></td>
        </tr>

        <tr>
            <td class="label">Date Submitted</td>
            <td>@Model.Complaint.DateSubmitted</td>
        </tr>

        <tr>
            <td class="label">Resolution Confirmation</td>
            <td>
                This complaint has been reviewed and marked as <strong>Resolved</strong>
                by the Quality Control Office.
            </td>
        </tr>

    </table>

    <div class="print-btn">
        <button onclick="window.print()" class="btn btn-primary">
            Print Report
        </button>
    </div>

</div>