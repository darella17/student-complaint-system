@page
@model AdminDashboardModel

<div class="mb-3 text-end">
    <a class="btn btn-danger btn-sm" href="/Logout">
        Logout
    </a>
</div>

<h2 class="mb-4 text-primary fw-bold">
    Admin Dashboard
</h2>

<!-- STATS CARDS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="card border-primary shadow-lg">
            <div class="card-body text-center">
                <h5 class="text-primary">Total Complaints</h5>
                <h2 class="fw-bold">@Model.Complaints.Count</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-warning shadow-lg">
            <div class="card-body text-center">
                <h5 class="text-warning">Pending</h5>
                <h2 class="fw-bold">@Model.Complaints.Count(c => c.Status == "Pending")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-success shadow-lg">
            <div class="card-body text-center">
                <h5 class="text-success">Resolved</h5>
                <h2 class="fw-bold">@Model.Complaints.Count(c => c.Status == "Fully Resolved")</h2>
            </div>
        </div>
    </div>

</div>

<h5 class="mt-4 mb-3">All Complaints</h5>

<form method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
            <option value="">All</option>
            <option value="Pending">Pending</option>
            <option value="Fully Resolved">Fully Resolved</option>
        </select>
    </div>

    <!-- CATEGORY FILTER (NEW) -->
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
            <option value="">All</option>
            <option>Water Supply</option>
            <option>Electricity</option>
            <option>Hostel</option>
            <option>Academics</option>
            <option>Lecturer</option>
            <option>Security</option>
            <option>Fees</option>
            <option>ICT / Internet</option>
            <option>Others</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Level</label>
        <select name="level" class="form-select">
            <option value="">All</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Matric Number</label>
        <input type="text"
               name="matricNumber"
               class="form-control"
               placeholder="Enter matric number..." />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Filter
        </button>
    </div>

</form>

<style>
    table.force-table {
        border-collapse: collapse;
        width: 100%;
    }

    table.force-table th,
    table.force-table td {
        border: 2px solid #000 !important;
        padding: 10px;
    }

    table.force-table th {
        background-color: #212529;
        color: white;
    }
</style>

<div class="table-responsive">

    <table class="force-table">

        <thead>
            <tr>
                <th>Student Name</th>
                <th>Matric Number</th>
                <th>Level</th>
                <th>Category</th>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Date Submitted</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model.Complaints)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.MatricNumber</td>
                <td>@item.Level</td>
                <td>@item.Category</td>
                <td>@item.Title</td>
                <td>@item.Description</td>

                <td>
                    @if (item.Status == "Fully Resolved")
                    {
                        <span class="badge bg-success">Fully Resolved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@item.Status</span>
                    }
                </td>

                <td>@item.DateSubmitted</td>

                <td>
                    @if (item.Status != "Fully Resolved")
                    {
                        <a class="btn btn-sm btn-success"
                           href="/Resolve?id=@item.Id">
                            Resolve
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary"
                           href="/PrintReport?id=@item.Id"
                           target="_blank">
                            Print
                        </a>
                    }
                </td>
            </tr>
        }

        </tbody>

    </table>

</div>